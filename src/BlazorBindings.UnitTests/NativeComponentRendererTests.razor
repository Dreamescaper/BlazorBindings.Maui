@using BlazorBindings.UnitTests.Components;
@using BlazorBindings.UnitTests.Elements;
@using BlazorBindings.Core;

@inherits ElementTestBase

@code
{
    [Test]
    public async Task TargetElementsShouldHavePropertiesSetWhenAddedToParents()
    {
        var parent = await Render<TestContainerComponent.TestTargetElement>(
    @<TestContainerComponent X="1" Y="2">
        <TestContainerComponent X="3" Y="4">
            <WrapperWithCascadingValue>
                <TestContainerComponent X="5" Y="6" />
            </WrapperWithCascadingValue>
            <TestContainerComponent X="7" Y="8" />
        </TestContainerComponent>

        <TestContainerComponent X="9" Y="10" />
    </TestContainerComponent>
    );

        Assert.That((parent.X, parent.Y), Is.EqualTo((1, 2)));

        var child0 = parent.Children[0];
        var child1 = parent.Children[1];

        Assert.That((child0.X, child0.Y), Is.EqualTo((3, 4)));
        Assert.That((child1.X, child1.Y), Is.EqualTo((9, 10)));

        var child00 = child0.Children[0];
        var child01 = child0.Children[1];

        Assert.That((child00.X, child00.Y), Is.EqualTo((5, 6)));
        Assert.That((child01.X, child01.Y), Is.EqualTo((7, 8)));
    }

    [Test]
    public async Task ConsecutiveAddsShouldUseAddRange()
    {
        var parent = await Render<RecordingContainerComponent.RecordingContainerTarget>(
    @<RecordingContainerComponent>
        <RecordingChildComponent Id="1" />
        <RecordingChildComponent Id="2" />
        <RecordingChildComponent Id="3" />
    </RecordingContainerComponent>
    );

        Assert.That(parent.Children.Select(child => child.Id), Is.EqualTo(new[] { 1, 2, 3 }));
        Assert.That(parent.Operations, Has.Count.EqualTo(1));
        Assert.That((parent.Operations[0].Name, parent.Operations[0].Index, parent.Operations[0].Count), Is.EqualTo(("AddRange", 0, 3)));
        Assert.That(parent.Operations[0].NewChildIds, Is.EqualTo(new[] { 1, 2, 3 }));
    }

    [Test]
    public async Task ConsecutiveRemovesShouldUseRemoveRange()
    {
        var showMiddleItems = true;

        var parent = await Render<RecordingContainerComponent.RecordingContainerTarget>(
    @<RecordingContainerComponent>
        <RecordingChildComponent Id="1" />
        @if (showMiddleItems)
        {
            <RecordingChildComponent Id="2" />
            <RecordingChildComponent Id="3" />
        }
        <RecordingChildComponent Id="4" />
    </RecordingContainerComponent>
    );

        parent.Operations.Clear();

        showMiddleItems = false;
        StateHasChanged();

        Assert.That(parent.Children.Select(child => child.Id), Is.EqualTo(new[] { 1, 4 }));
        Assert.That(parent.Operations, Has.Count.EqualTo(1));
        Assert.That((parent.Operations[0].Name, parent.Operations[0].Index, parent.Operations[0].Count), Is.EqualTo(("RemoveRange", 1, 2)));
        Assert.That(parent.Operations[0].NewChildIds, Is.Empty);
    }

    [Test]
    public async Task ReplacementDiffWithoutKeysShouldUseReplaceRange()
    {
        var useFirstSet = true;

        var parent = await Render<RecordingContainerComponent.RecordingContainerTarget>(
    @<RecordingContainerComponent>
        @if (useFirstSet)
        {
            <RecordingChildComponent Id="1" />
            <RecordingChildComponent Id="2" />
            <RecordingChildComponent Id="3" />
        }
        else
        {
            <AlternateRecordingChildComponent Id="4" />
            <AlternateRecordingChildComponent Id="5" />
            <AlternateRecordingChildComponent Id="6" />
        }
    </RecordingContainerComponent>
    );

        parent.Operations.Clear();

        useFirstSet = false;
        StateHasChanged();

        Assert.That(parent.Children.Select(child => child.Id), Is.EqualTo(new[] { 4, 5, 6 }));
        Assert.That(parent.Operations, Has.Count.EqualTo(1), FormatOperations(parent.Operations));
        Assert.That((parent.Operations[0].Name, parent.Operations[0].Index, parent.Operations[0].Count), Is.EqualTo(("ReplaceRange", 0, 3)));
        Assert.That(parent.Operations[0].NewChildIds, Is.EqualTo(new[] { 4, 5, 6 }));
    }

    [Test]
    public async Task ReplacementDiffWithKeysShouldUseReplaceRange()
    {
        var useFirstSet = true;

        var parent = await Render<RecordingContainerComponent.RecordingContainerTarget>(
    @<RecordingContainerComponent>
        @if (useFirstSet)
        {
            <RecordingChildComponent @key="1" Id="1" />
            <RecordingChildComponent @key="2" Id="2" />
            <RecordingChildComponent @key="3" Id="3" />
        }
        else
        {
            <AlternateRecordingChildComponent Id="4" />
            <AlternateRecordingChildComponent Id="5" />
            <AlternateRecordingChildComponent Id="6" />
        }
    </RecordingContainerComponent>
    );

        parent.Operations.Clear();

        useFirstSet = false;
        StateHasChanged();

        Assert.That(parent.Children.Select(child => child.Id), Is.EqualTo(new[] { 4, 5, 6 }));
        Assert.That(parent.Operations, Has.Count.EqualTo(1), FormatOperations(parent.Operations));
        Assert.That((parent.Operations[0].Name, parent.Operations[0].Index, parent.Operations[0].Count), Is.EqualTo(("ReplaceRange", 0, 3)));
        Assert.That(parent.Operations[0].NewChildIds, Is.EqualTo(new[] { 4, 5, 6 }));
    }

    [Test]
    public void ElementManagerShouldDispatchReplaceRange()
    {
        var component = new RecordingContainerComponent();
        var target = (RecordingContainerComponent.RecordingContainerTarget)((BlazorBindings.Core.IElementHandler)component).TargetElement;
        target.Children.AddRange([
            new() { Id = 1 },
            new() { Id = 2 },
            new() { Id = 3 }
        ]);

        new ElementManager().ReplaceChildElementRange(
            component,
            3,
            (ReadOnlySpan<object>)[
                new RecordingChildTarget { Id = 4 },
                new RecordingChildTarget { Id = 5 },
                new RecordingChildTarget { Id = 6 }
            ],
            0);

        Assert.That(target.Children.Select(child => child.Id), Is.EqualTo(new[] { 4, 5, 6 }));
        Assert.That(target.Operations, Has.Count.EqualTo(1));
        Assert.That((target.Operations[0].Name, target.Operations[0].Index, target.Operations[0].Count), Is.EqualTo(("ReplaceRange", 0, 3)));
        Assert.That(target.Operations[0].NewChildIds, Is.EqualTo(new[] { 4, 5, 6 }));
    }

    private static string FormatOperations(IEnumerable<RecordingContainerComponent.RecordingOperation> operations)
        => string.Join("; ", operations.Select(operation => $"{operation.Name}({operation.Index}, {operation.Count}, [{string.Join(",", operation.NewChildIds)}])"));
}
