<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<!-- Build -->
		<PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
	</ItemGroup>

	<ItemGroup>
		<!-- Test -->
		<PackageVersion Include="coverlet.collector" Version="10.0.1" />
		<PackageVersion Include="nunit" Version="4.6.1" />
		<PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
		<PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Component generator -->
		<PackageVersion Include="CommandLineParser" Version="2.9.1" />
		<PackageVersion Include="Microsoft.Build.Framework" Version="17.11.48" />
		<PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Blazor -->
		<PackageVersion Include="Microsoft.AspNetCore.Components" Version="11.0.0-rc.1.26425.128" />
	</ItemGroup>

	<ItemGroup>
		<!-- MAUI -->
		<!-- Be careful with updating, as it might cause issues with the version available in workloads via $(MauiVersion) -->
		<PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.0-rc.1.26451.6" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="11.0.0-rc.1.26451.6" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-rc.1.26425.128" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0-rc.1.26425.128" />
	</ItemGroup>

	<ItemGroup>
		<!-- Samples -->
		<PackageVersion Include="Blazored.FluentValidation" Version="2.2.0" />
		<PackageVersion Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageVersion Include="CommunityToolkit.Maui.Markup" Version="8.0.0" />
		<PackageVersion Include="Fluxor.Blazor.Web" Version="6.11.0" />
		<PackageVersion Include="Material.Components.Maui" Version="0.1.2-beta" />
		<PackageVersion Include="MPowerKit.VirtualizeListView" Version="2.8.0" />
		<PackageVersion Include="SkiaSharp.Views.Maui.Controls" Version="4.152.1" />
		<PackageVersion Include="sqlite-net-pcl" Version="1.11.285" />
		<PackageVersion Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
		<PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
		<PackageVersion Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="3.0.5" />
		<PackageVersion Include="Syncfusion.Maui.Toolkit" Version="1.0.11" />
		<PackageVersion Include="The49.Maui.BottomSheet" Version="8.0.3" />
		<PackageVersion Include="UraniumUI.Icons.FontAwesome" Version="3.0.0" />
		<PackageVersion Include="XCalendar.Maui" Version="4.8.0" />
	</ItemGroup>
</Project>
